# Port binding for AI Studio Supervisor (must remain 3000)
PORT=3000

# Google Gemini API Key for server-side inference
GEMINI_API_KEY=

# SupremeAI Mock-to-Real Adapter Flag (true = local mock, false = live backend proxy)
VITE_USE_MOCK=false

# SupremeAI Backend Microservice Endpoints
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://auth.supremeai.bd
VITE_GATEWAY_URL=https://gateway.supremeai.bd/v1
VITE_MCP_TOWER_URL=https://supremeai-mcp-tower.onrender.com/mcp

# Root Administrator Passkey
ADMIN_PASSKEY=supremeai-admin-2026
